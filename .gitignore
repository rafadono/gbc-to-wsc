# Binaries & build artifacts
*.exe
*.o
*.wsc
build/
bin/
dist/
test_runner

# ROM files & save data (Never commit copyrighted game files)
roms/*.gb
roms/*.gbc
roms/*.bin
roms/*.sav
!roms/.gitkeep
!roms/README.md

# Editor & OS files
.vscode/
.idea/
Thumbs.db
.DS_Store

# Python cache
__pycache__/
*.pyc

# External test runners
tools/runner/*
!tools/runner/README.md
!tools/runner/.gitkeep
